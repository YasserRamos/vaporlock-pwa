@import "tailwindcss";

:root {
  font-family: Arial, Helvetica, sans-serif;
  color: #f4e8cf;
  background: #11131a;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;

  --vl-bg: #11131a;
  --vl-panel: #1c202a;
  --vl-paper: #f4e8cf;
  --vl-muted: #b8b1a3;
  --vl-red: #bd4034;
  --vl-orange: #e38a42;
  --vl-teal: #5ca8a0;
  --vl-ink: #08090d;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: var(--vl-bg);
}

body, button, a {
  -webkit-tap-highlight-color: transparent;
}

button, a {
  touch-action: manipulation;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

img {
  max-width: 100%;
}

::selection {
  color: var(--vl-ink);
  background: var(--vl-orange);
}

.pixel-texture {
  background-image: radial-gradient(#ffffff0c 1px, transparent 1px);
  background-size: 5px 5px;
}

.comic-border {
  border: 3px solid var(--vl-ink);
  box-shadow: 5px 5px 0 var(--vl-ink);
}

.comic-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  min-height: 46px;
  padding: 0.75rem 1.1rem;
  border: 3px solid var(--vl-ink);
  box-shadow: 4px 4px 0 var(--vl-ink);
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  transition: transform 150ms ease, box-shadow 150ms ease;
}

.comic-button:hover {
  transform: translate(2px, 2px);
  box-shadow: 2px 2px 0 var(--vl-ink);
}

.comic-button:focus-visible,
a:focus-visible,
button:focus-visible {
  outline: 3px solid var(--vl-orange);
  outline-offset: 4px;
}

.comic-heading {
  font-weight: 1000;
  line-height: 0.95;
  letter-spacing: -0.045em;
  text-transform: uppercase;
  text-wrap: balance;
}

.comic-panel {
  position: relative;
  border: 3px solid var(--vl-ink);
  background: var(--vl-panel);
  box-shadow: 6px 6px 0 var(--vl-ink);
}

.hero-grid {
  background-image:
    linear-gradient(#ffffff08 1px, transparent 1px),
    linear-gradient(90deg, #ffffff08 1px, transparent 1px);
  background-size: 24px 24px;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}





/* ===== VAPORLOCK: TIPOGRAFÍAS ===== */

@font-face {
  font-family: "Bangers";
  src: url("/fonts/Bangers-Regular.ttf") format("truetype");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: "Staatliches";
  src: url("/fonts/Staatliches-Regular.ttf") format("truetype");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

/* Títulos principales y encabezados de impacto */
h1,
.comic-title {
  font-family: "Bangers", sans-serif;
  letter-spacing: 0.04em;
}

/* Subtítulos, navegación y encabezados de sección */
h2,
h3,
nav,
.section-title {
  font-family: "Staatliches", sans-serif;
}





/* =========================================
   VAPORLOCK — STEAMPUNK COMIC DESIGN SYSTEM
   ========================================= */

:root {
  --vl-bg: #17191c;
  --vl-bg-deep: #101215;
  --vl-paper: #e9d5ad;
  --vl-paper-dark: #c2a779;
  --vl-brass: #c28b43;
  --vl-copper: #8f4c32;
  --vl-turquoise: #24d7d1;
  --vl-red: #e34c3b;
  --vl-ink: #090a0c;
  --vl-text: #f5eee0;
  --vl-muted: #b6b0a4;

  --vl-outline: 3px solid var(--vl-ink);
  --vl-shadow: 6px 6px 0 var(--vl-ink);
}

/* Logotipo: nunca dividir VAPORLOCK en dos líneas */
.vaporlock-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
}

.vaporlock-logo img {
  display: block;
  width: 100%;
  max-width: 780px;
  height: auto;
  object-fit: contain;
}

.vaporlock-logo__fallback {
  display: block;
  white-space: nowrap;
  color: var(--vl-brass);
  font-family: "Bangers", Impact, sans-serif;
  font-size: clamp(1.5rem, 7vw, 5rem);
  line-height: 1;
  letter-spacing: 0.035em;
  text-shadow:
    3px 3px 0 var(--vl-ink),
    -1px -1px 0 var(--vl-ink);
}

/* Fondo industrial */
body {
  background-color: var(--vl-bg);
  color: var(--vl-text);
}

/* Textura de impresión de cómic */
.comic-halftone {
  background-image: radial-gradient(
    circle,
    rgb(0 0 0 / 35%) 1px,
    transparent 1.5px
  );
  background-size: 7px 7px;
}

/* Viñetas con borde de tinta */
.comic-panel {
  position: relative;
  overflow: hidden;
  border: var(--vl-outline);
  box-shadow: var(--vl-shadow);
  background-color: var(--vl-paper);
  color: var(--vl-ink);
}

/* Detalles diagonales */
.comic-slash {
  position: relative;
  isolation: isolate;
}

.comic-slash::before {
  position: absolute;
  z-index: -1;
  inset: 0 auto 0 0;
  width: 8px;
  background: var(--vl-red);
  content: "";
  transform: skewX(-12deg);
  transform-origin: top;
}

/* Etiquetas tipo portada de cómic */
.comic-label {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.35rem 0.65rem;
  border: 2px solid var(--vl-ink);
  background: var(--vl-red);
  color: white;
  font-family: "Staatliches", Impact, sans-serif;
  font-size: 0.9rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  box-shadow: 3px 3px 0 var(--vl-ink);
  transform: rotate(-2deg);
}

/* Botones metálicos */
.comic-button {
  border: 3px solid var(--vl-ink);
  background: var(--vl-brass);
  color: var(--vl-ink);
  box-shadow: 4px 4px 0 var(--vl-ink);
  font-family: "Staatliches", Impact, sans-serif;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  transition:
    transform 160ms ease,
    box-shadow 160ms ease,
    background-color 160ms ease;
}

.comic-button:hover {
  background: var(--vl-turquoise);
  transform: translate(2px, 2px);
  box-shadow: 2px 2px 0 var(--vl-ink);
}

.comic-button:focus-visible {
  outline: 3px solid var(--vl-turquoise);
  outline-offset: 4px;
}

/* Encabezados */
h1,
h2,
.comic-title {
  font-family: "Bangers", Impact, sans-serif;
  letter-spacing: 0.035em;
}

h3,
.section-title,
nav {
  font-family: "Staatliches", Impact, sans-serif;
}

/* Elementos decorativos industriales */
.steampunk-divider {
  height: 6px;
  border-top: 2px solid var(--vl-ink);
  border-bottom: 2px solid var(--vl-ink);
  background: repeating-linear-gradient(
    135deg,
    var(--vl-brass) 0 10px,
    var(--vl-copper) 10px 20px
  );
}

/* Movimiento reducido para accesibilidad */
@media (prefers-reduced-motion: reduce) {
  .comic-button {
    transition: none;
  }

  .comic-button:hover {
    transform: none;
  }
}
